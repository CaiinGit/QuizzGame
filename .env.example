# Generate a random hexadecimal password: openssl rand -hex 32
POSTGRES_PASSWORD=
# HTTPS origin of the Tailscale Serve URL, or the public domain (no final slash).
AKASHA_ORIGIN=https://server.example.ts.net
# Only used by compose.public.yaml:
AKASHA_DOMAIN=akasha.example.fr
# Optional: compile the server address into the APK (otherwise set it in the app).
# VITE_SERVER_URL=https://server.example.ts.net
