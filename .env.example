# Generate a random hexadecimal password: openssl rand -hex 32
POSTGRES_PASSWORD=
# Public HTTPS origin.
AKASHA_ORIGIN=https://akashaquiz.com
# Private by default. Set public only when intentionally reopening registration/guest access.
AKASHA_ACCESS=private
# Optional: read-only Google Sheet synchronization on this server (one poll per minute).
# The document must already be readable via link. Leave empty for isolated development.
AKASHA_QUESTION_SHEET_ID=
# Multiple themes: JSON object mapping known theme IDs to distinct spreadsheet IDs.
# Takes precedence over the legacy One Piece variable above. Leave empty in development.
# AKASHA_QUESTION_SHEETS='{"one-piece":"GOOGLE_SHEET_ID","mcu":"ANOTHER_GOOGLE_SHEET_ID"}'
# AKASHA_QUESTION_SHEET_LAYOUT=catalog
AKASHA_QUESTION_SHEETS=
# Named Cloudflare tunnel UUID (not a secret). Credentials stay in work/cloudflare/.
CLOUDFLARE_TUNNEL_ID=
# Only used by compose.public.yaml:
AKASHA_DOMAIN=akashaquiz.com
# Optional: compile the server address into the APK (otherwise set it in the app).
# VITE_SERVER_URL=https://akashaquiz.com
